GROQ_API_KEY=your_key_here
CHROMA_PERSIST_DIR=./chroma_store
OUTPUT_DIR=./generated_reports
# Optional -- defaults to ./evaluation_log.jsonl if omitted. Every /process
# run's evaluation summary is appended here; viewable via the "Run history"
# panel in the UI or the /evaluation-history endpoint.
EVALUATION_LOG_PATH=./evaluation_log.jsonl

# Optional: max source-excerpt tokens per report request (Groq free tier ~8000 TPM)
# GROQ_MAX_CONTEXT_TOKENS=5000

# Optional: describe PDF figures with Groq's vision model (default true), and
# where those descriptions are cached between runs.
# FIGURE_CAPTIONING_ENABLED=true
# FIGURE_CACHE_PATH=./figure_cache.json

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
# true when served over HTTPS (keeps the refresh cookie off plain HTTP)
# COOKIE_SECURE=false
# Origins allowed to call the API directly (the /api proxy needs none)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AUTH_DB_PATH=./researchlens.db
# Set to false once your accounts exist (python -m app.create_user still works)
# ALLOW_REGISTRATION=true

# --- Celery ---
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# true = run the pipeline inside the API process (no Redis/worker needed)
# CELERY_TASK_ALWAYS_EAGER=false
# UPLOAD_DIR=./job_uploads
# Parallel pipeline runs per worker on Linux/macOS/WSL (ignored on native Windows)
# CELERY_WORKER_CONCURRENCY=2
# Where workers share Groq rate-limit pacing; defaults to CELERY_BROKER_URL. Empty = per-process.
# GROQ_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

# --- arXiv digests (/papers/arxiv/*) ---
# Papers one /papers/arxiv/process job may include. Each one shares the
# same GROQ_MAX_CONTEXT_TOKENS budget, so more papers = fewer excerpts each.
# ARXIV_MAX_PAPERS_PER_RUN=8

# --- Quality / retrieval features (all default on) ---
# Check robots.txt before every crawl fetch. Only turn off for sites you own.
# CRAWL_RESPECT_ROBOTS_TXT=true
# Iterative multi-hop retrieval for targeted_qa/analysis instructions
# MULTI_HOP_ENABLED=true
# LLM judge checking each cited claim against the excerpt it cites
# ENTAILMENT_CHECK_ENABLED=true
# Rewrite only the sentences the entailment check flags
# CLAIM_REVISION_ENABLED=true
# ephemeral (default: in memory, dropped after each run) or persistent (CHROMA_PERSIST_DIR)
# CHROMA_MODE=ephemeral
